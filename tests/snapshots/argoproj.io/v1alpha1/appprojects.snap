=== wide default/platform
name: "platform"
namespace: "default"
destinationCount: 2
sourceRepos:
  - "https://github.com/example/*"
  - "https://charts.example.com"
created: 2026-10-27T21:40:06+00:00
owner: null
destinations:
  - namespace: "web"
    server: "https://kubernetes.default.svc"
  - name: "in-cluster"
    namespace: "shop"
sourceNamespaces:
  - "platform-*"
clusterResourceWhitelist:
  - group: ""
    kind: "Namespace"
clusterResourceBlacklist: []
namespaceResourceWhitelist: []
namespaceResourceBlacklist:
  - group: ""
    kind: "ResourceQuota"
roles:
  - groups:
      - "platform-team"
    name: "deployer"
    policies:
      - "p, proj:platform:deployer, applications, sync, platform/*, allow"
