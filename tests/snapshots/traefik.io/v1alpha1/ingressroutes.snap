owner: null
routes:
  - kind: "Rule"
    match: "Host(`web.example.com`) && PathPrefix(`/api`)"
    middlewares:
      - name: "strip-api"
    priority: 10
    services:
      - name: "web"
        port: 80
        weight: 3
      - name: "web-canary"
        port: "http"
        weight: 1
  - kind: "Rule"
    match: "Host(`web.example.com`)"
    services:
      - name: "web"
        port: 80
tls:
  options:
    name: "strict"
  secretName: "web-tls"
